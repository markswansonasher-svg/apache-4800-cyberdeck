# Minecraft server settings - copied to C:\deck\game-servers\.env
#
# Minecraft's EULA: read https://aka.ms/MinecraftEULA . The server will not
# start until you change this to TRUE, which means you agree to it.
MC_EULA=FALSE

# VANILLA, PAPER (faster, plugins), FABRIC, or NEOFORGE (mods)
MC_TYPE=VANILLA
# LATEST, or a version like 1.21.4
MC_VERSION=LATEST
# Java heap. Keep it under the 8 GB container limit.
MC_MEMORY=6G
# Modpacks are set up from the Deck Panel (Modpacks card) and keep their
# own settings in packs\<name>.env - you don't need to change anything here.

MC_MOTD=Apache 4800 deck
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=10

# Only listed players can join. Comma-separated Minecraft usernames.
MC_WHITELIST=TRUE
MC_WHITELIST_PLAYERS=
# Server operators (admins). Comma-separated usernames.
MC_OPS=

TZ=America/New_York
